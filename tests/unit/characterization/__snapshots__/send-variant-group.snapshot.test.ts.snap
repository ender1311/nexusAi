exports[`characterization: sendVariantGroup Braze contract push — immediate 1`] = `
{
  "db": [
    {
      "args": {
        "data": {
          "brazeSendId": "<uuid>",
        },
        "where": {
          "id": {
            "in": [
              "d1",
              "d2",
            ],
          },
        },
      },
      "op": "userDecision.updateMany",
    },
  ],
  "requests": [
    {
      "body": {
        "campaign_id": "nexus-campaign",
        "messages": {
          "android_push": {
            "alert": "Body",
            "app_id": "android-app",
            "custom_uri": "youversion://home",
            "message_variation_id": "bv-push",
            "title": "Title",
          },
          "apple_push": {
            "alert": {
              "body": "Body",
              "title": "Title",
            },
            "app_id": "ios-app",
            "custom_uri": "youversion://home",
            "message_variation_id": "bv-push",
          },
        },
        "recipients": [
          {
            "external_user_id": "u1",
          },
          {
            "braze_id": "braze-only-1",
          },
        ],
        "schedule": {
          "time": "2026-05-30T12:00:00.000Z",
        },
      },
      "method": "POST",
      "url": "https://rest.test.braze.com/messages/schedule/create",
    },
  ],
  "result": {
    "errors": 0,
    "sent": 2,
  },
}
`;

